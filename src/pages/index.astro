---
import '../styles/reference.css';
const services = [ ['Shopify & Commerce','Tiendas rápidas y una compra clara. Rediseño, desarrollo y experiencia de compra.'], ['Experiencias web','Sitios a medida con diseño, interacción y contenido que explican tu negocio.'], ['Software a medida','Aplicaciones web y portales que resuelven procesos reales de tu empresa.'], ['Productos digitales','Diseño y desarrollo de MVP para validar y lanzar tu próximo producto.'] ];
const steps = ['Descubrir','Diseñar','Construir','Lanzar'];
const concepts = ['Comercio','Experiencia digital','Portal de negocio','Producto SaaS'];
const email = import.meta.env.PUBLIC_CONTACT_EMAIL ?? '';
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>diferio. — Creative Technology Company</title><meta name="description" content="Diseño, software y comercio. Experiencias Shopify, sitios web y aplicaciones a medida para empresas en México."/><meta property="og:title" content="diferio. — Ordinary isn't enough."/><meta property="og:description" content="Diseño, software y comercio para hacer que tu negocio se distinga."/></head>
<body><a class="skip" href="#main">Ir al contenido</a><div class="shell"><aside class="sidebar"><div class="cover"></div><div class="identity"><span class="avatar">d.</span><div><strong>diferio.</strong><small>Creative Technology Company</small></div></div><p class="intro">Creamos experiencias digitales, comercio y software que hacen que los negocios se distingan.</p><nav aria-label="Principal"><a href="#about">♧ &nbsp; Nosotros</a><a href="#services">▣ &nbsp; Servicios</a><a href="#works">↗ &nbsp; Proyectos</a><a href="#process">▤ &nbsp; Proceso</a></nav><div class="sidebar-bottom"><p>DESIGN / SOFTWARE / COMMERCE</p><a class="button" href="#contact">Iniciar un proyecto ↗</a></div></aside>
<main id="main"><header><div class="status"><b>d.</b><span>diferio.</span><span><i></i> Nuevos proyectos</span></div><p>Desde México<br/><strong>Para tu negocio</strong></p></header>
<section class="hero" id="about"><a class="announcement" href="#works">Explora nuestros conceptos &nbsp; →</a><h1>Somos diferio.<br/>Diseño <span class="mini-mark">d.</span> & Tecnología</h1><p>Ordinary isn't enough.</p><div class="gallery" aria-label="Exploraciones gráficas originales"><div class="gallery-track">{[...concepts,...concepts].map((name,i)=><div class={`tile tile-${i%4}`}><span>d.</span><small>{name}</small></div>)}</div></div></section>
<section id="works"><span class="eyebrow">Proyectos seleccionados</span><h2>Ideas que cuentan<br/>otra historia.</h2><div class="work-grid">{concepts.map((name,i)=><article><div class={`art tile-${i}`}><span>{['d/shop','d/web','d/portal','d/product'][i]}</span></div><div class="caption"><h3>{name}</h3><span>Concepto / 0{i+1}</span></div><p>Exploración conceptual de DIFERIO. No representa un cliente ni un proyecto entregado.</p></article>)}</div></section>
<section id="services"><span class="eyebrow">Servicios</span><h2>Diseñamos para avanzar.<br/>Construimos para funcionar.</h2><p class="lead">Diseño, ingeniería y criterio comercial para resolver lo que tu negocio necesita.</p><div class="services">{services.map(([name,description],i)=><article><span>0{i+1}</span><h3>{name}</h3><p>{description}</p><a href="#contact">Hablemos de tu proyecto ↗</a></article>)}</div></section>
<section id="process"><span class="eyebrow">Proceso</span><h2>De la idea<br/>a la experiencia.</h2><p class="lead">Entendemos el reto, definimos la experiencia y construimos una solución lista para usarse.</p>{steps.map((step,i)=><div class="step"><small>Paso 0{i+1}</small><h3>{step}</h3><p>{['Objetivos · Usuarios · Alcance','Estructura · Identidad · Prototipo','Desarrollo · Integración · Pruebas','Publicación · Entrega · Evolución'][i]}</p></div>)}</section>
<section><span class="eyebrow">Nuestra experiencia</span><h2>La base de lo<br/>que construimos.</h2>{services.map(([name,description])=><div class="experience"><h3>{name}</h3><p>{description}</p></div>)}</section>
<section class="philosophy"><div class="philosophy-art"><span>d.</span></div><div><span class="eyebrow">Nuestra filosofía</span><h2>El diseño tiene<br/>que significar algo.</h2><p>Software should feel different.<br/>Commerce should work better.<br/>Design should mean something.</p><p>La tecnología debe facilitar el trabajo. El diseño debe dar claridad. Cada decisión debe tener una razón.</p></div></section>
<section><span class="eyebrow">Compromisos</span><h2>Lo que puedes esperar<br/>de nuestro trabajo.</h2><blockquote>Claridad en el alcance, decisiones con propósito y una base técnica que pueda crecer contigo.</blockquote><p>Compartiremos casos y testimonios cuando contemos con resultados verificables y autorización de publicación.</p></section>
<section><span class="eyebrow">Herramientas</span><h2>La tecnología adecuada<br/>para cada problema.</h2><div class="tools">{['Shopify / Comercio','Astro / Sitios rápidos','TypeScript / Aplicaciones','APIs / Integraciones','Diseño UX / UI','Accesibilidad / Rendimiento'].map(tool=><div>{tool}<span>↗</span></div>)}</div></section>
<section><span class="eyebrow">Archivo conceptual</span><div class="archive">{concepts.map((name,i)=><div class={`tile tile-${i}`}><span>d.</span><small>{name}</small></div>)}</div></section>
<section><span class="eyebrow">Ideas</span><h2>Espacio para<br/>pensar diferente.</h2><div class="journal">{['Una compra con menos fricción','Un sitio que explica tu negocio','Software que simplifica el trabajo'].map((title,i)=><article><div class={`art tile-${i}`}>0{i+1}</div><h3>{title}</h3><p>Una línea de exploración de DIFERIO.</p></article>)}</div></section>
<section><span class="eyebrow">Preguntas frecuentes</span><h2>Antes de empezar.</h2>{[['¿Pueden trabajar con mi sitio actual?','Sí. Primero revisamos su estructura y tus objetivos para definir qué conservar y qué mejorar.'],['¿Qué tipo de proyectos construyen?','Tiendas Shopify, sitios web, experiencias interactivas, aplicaciones, portales y MVP de SaaS.'],['¿Cuánto tarda un proyecto?','El plazo depende del alcance y las integraciones. Lo definimos antes de comenzar.'],['¿Qué necesitan para empezar?','Una descripción del negocio, el problema a resolver y una idea del presupuesto y plazo.']].map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
<section id="contact"><span class="eyebrow">Contacto</span><h2>Hagamos algo<br/>diferente.</h2><p>Cuéntanos qué necesita tu negocio y qué quieres construir.</p>{email ? <a class="contact-button" href={`mailto:${email}`}>Iniciar conversación ↗</a> : <p class="contact-note">El canal de contacto se habilitará próximamente.</p>}</section><footer><strong>diferio.</strong><p>Design / Software / Commerce</p><a href="#main">Volver arriba ↑</a><small>© {new Date().getFullYear()} DIFERIO</small></footer></main></div></body></html>
