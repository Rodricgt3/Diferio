---
import '../styles/reference.css';
import '../styles/expansion.css';
import CaseStudy from '../components/CaseStudy.astro';
import { resolvePath } from '../utils/paths';

const services = [
  {
    name: 'Commerce',
    description: 'Tiendas rápidas y una compra clara. Catálogo editorial, optimización de conversión y checkout sin fricción.',
    link: '/commerce/',
    action: 'Explorar experiencia de comercio ↗'
  },
  {
    name: 'Digital Experiences',
    description: 'Sitios a medida con diseño de autor, tipografía monumental, micro-interacciones y narrativa que explican tu negocio.',
    link: '/experiences/',
    action: 'Ver laboratorio de experiencias ↗'
  },
  {
    name: 'Software & Products',
    description: 'Aplicaciones web, portales privados, gestión empresarial y MVP de SaaS para resolver procesos de negocio.',
    link: '/software/',
    action: 'Probar demo de plataforma ↗'
  },
  {
    name: 'Motion & Film',
    description: 'Edición profesional, reels comerciales, películas promocionales, motion graphics y video sales letters.',
    link: '/motion/',
    action: 'Explorar Motion & Film ↗'
  }
];

const steps = ['Descubrir', 'Diseñar', 'Construir', 'Lanzar'];

const concepts = [
  {
    name: 'Atelier Objets / E-Commerce',
    code: 'd/shop',
    type: 'Concepto',
    desc: 'Exploración de catálogo, variantes y resumen de compra. No procesa pagos.',
    tech: 'Shopify Liquid · TypeScript · Astro · LCP 0.8s',
    link: '/commerce/'
  },
  {
    name: 'Studio V / Arquitectura',
    code: 'd/web',
    type: 'Concepto',
    desc: 'Sitio editorial inmersivo con retícula activa de 12 columnas, escala tipográfica fluida y modo blueprint técnico.',
    tech: 'Frontend Cinético · CSS Grid · 60 FPS · WCAG AA',
    link: '/experiences/'
  },
  {
    name: 'Pulse OS / Portal Operativo',
    code: 'd/portal',
    type: 'Concepto',
    desc: 'Interfaz operativa con datos simulados y filtrado de órdenes. No está conectada a sistemas reales.',
    tech: 'TypeScript · WebSockets · SVG Data Charts · PostgreSQL',
    link: '/software/'
  },
  {
    name: 'Vortex / Producto SaaS',
    code: 'd/product',
    type: 'Concepto',
    desc: 'Plataforma SaaS con autenticación de usuarios, roles operativos y facturación automatizada.',
    tech: 'SaaS MVP · APIs REST · Control de Permisos · Cloud',
    link: '/start/?service=product'
  }
];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width"/>
  <title>diferio. — Creative Technology Company</title>
  <meta name="description" content="Diseño, software y comercio. Experiencias Shopify, sitios web y aplicaciones a medida para empresas en México."/>
  <meta property="og:title" content="diferio. — Ordinary isn't enough."/>
  <meta property="og:description" content="Diseño, software y comercio para hacer que tu negocio se distinga."/>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' fill='%23151515'/><text x='50' y='68' font-size='56' font-family='Arial,sans-serif' font-weight='bold' fill='%23d8ff60' text-anchor='middle'>d.</text></svg>"/>
</head>
<body>
  <a class="skip" href="#main">Ir al contenido</a>
  <div class="shell">
    <aside class="sidebar">
      <div class="cover"></div>
      <div class="identity">
        <span class="avatar">d.</span>
        <div>
          <strong>diferio.</strong>
          <small>Creative Technology Company</small>
        </div>
      </div>
      <p class="intro">Creamos experiencias digitales, comercio y software que hacen que los negocios se distingan.</p>
      <nav aria-label="Principal">
        <a href="#about">♧ &nbsp; Nosotros</a>
        <a href="#services">▣ &nbsp; Servicios</a>
        <a href="#works">↗ &nbsp; Proyectos</a>
        <a href="#process">▤ &nbsp; Proceso</a>
      </nav>
      <div class="sidebar-bottom">
        <p>DESIGN / SOFTWARE / COMMERCE / MOTION</p>
        <a class="button" href={resolvePath('/start/')}>Iniciar un proyecto ↗</a>
      </div>
    </aside>

    <main id="main">
      <header>
        <div class="status">
          <b>d.</b>
          <span>diferio.</span>
          <span><i></i> Nuevos proyectos</span>
        </div>
        <p>Desde México<br/><strong>Para tu negocio</strong></p>
      </header>

      <!-- Hero Section -->
      <section class="hero" id="about">
        <a class="announcement" href="#works">Explora nuestros conceptos &nbsp; →</a>
        <h1>Somos diferio.<br/>Diseño <span class="mini-mark">d.</span> & Tecnología</h1>
        <p>Ordinary isn't enough.</p>
        <div class="gallery" aria-label="Exploraciones gráficas originales">
          <div class="gallery-track">
            {[...concepts, ...concepts].map((item, i) => (
              <div class={`tile tile-${i % 4}`}>
                <span>d.</span>
                <small>{item.name.split('/')[0].trim()}</small>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Works Section (Preserves exact work-grid UX) -->
      <section id="works">
        <span class="eyebrow">Demostraciones conceptuales</span><p>Prototipos navegables, sin clientes ni resultados atribuidos. Los trabajos de cliente y productos internos se publicarán como categorías independientes cuando existan casos autorizados.</p>
        <h2>Ideas que cuentan<br/>otra historia.</h2>
        <div class="work-grid">
          {concepts.slice(0,3).map((item,i) => <CaseStudy {...item} index={i}/>)}        </div>
      </section>

      <!-- Services Section (Preserves exact services grid UX) -->
      <section id="services">
        <span class="eyebrow">Servicios</span>
        <h2>Diseñamos para avanzar.<br/>Construimos para funcionar.</h2>
        <p class="lead">Diseño, ingeniería y criterio comercial para resolver lo que tu negocio necesita.</p>
        <div class="services">
          {services.map((item, i) => (
            <article>
              <div class={`service-preview tile-${i}`} aria-hidden="true">{["d/shop","d/web","d/product","d/film"][i]}</div><span>0{i + 1}</span>
              <h3>{item.name}</h3>
              <p>{item.description}</p>
              <a href={resolvePath(item.link)}>{item.action}</a>
            </article>
          ))}
        </div>
      </section>

      <!-- Process Section (Preserves exact process UX) -->
      <section id="process">
        <span class="eyebrow">Proceso</span>
        <h2>De la idea<br/>a la experiencia.</h2>
        <p class="lead">Entendemos el reto, definimos la experiencia y construimos una solución lista para usarse.</p>
        {steps.map((step, i) => (
          <div class="step">
            <small>Paso 0{i + 1}</small>
            <h3>{step}</h3>
            <p>{['Objetivos · Usuarios · Alcance', 'Estructura · Identidad · Prototipo', 'Desarrollo · Integración · Pruebas', 'Publicación · Entrega · Evolución'][i]}</p>
          </div>
        ))}
      </section>

      <!-- Philosophy Section -->
      <section class="philosophy">
        <div class="philosophy-art">
          <span>d.</span>
        </div>
        <div>
          <span class="eyebrow">Nuestra filosofía</span>
          <h2>El diseño tiene<br/>que significar algo.</h2>
          <p>
            Software should feel different.<br/>
            Commerce should work better.<br/>
            Design should mean something.
          </p>
          <p>
            La tecnología debe facilitar el trabajo. El diseño debe dar claridad y acelerar la conversión comercial. Cada decisión en DIFERIO tiene un propósito medible.
          </p>
        </div>
      </section>

      <!-- Commitments Section -->
      <section>
        <span class="eyebrow">Compromisos</span>
        <h2>Lo que puedes esperar<br/>de nuestro trabajo.</h2>
        <blockquote>Claridad en el alcance, decisiones con propósito y una base técnica que pueda crecer contigo.</blockquote>
        <p>Compartiremos casos y testimonios cuando contemos con resultados verificables y autorización de publicación.</p>
      </section>

      <!-- Tools Section -->
      <section>
        <span class="eyebrow">Herramientas</span>
        <h2>La tecnología adecuada<br/>para cada problema.</h2>
        <div class="tools">
          {['Shopify / Comercio de alta conversión', 'Astro / Sitios ultrarrápidos', 'TypeScript / Aplicaciones robustas', 'APIs / Integraciones y WebSockets', 'Diseño UX / UI Editorial', 'Accesibilidad / Core Web Vitals'].map((tool) => (
            <div>
              {tool}
              <span>↗</span>
            </div>
          ))}
        </div>
      </section>

      <!-- FAQ Section -->
      <section>
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2>Antes de empezar.</h2>
        {[
          ['¿Pueden trabajar con mi sitio actual?', 'Sí. Primero revisamos su estructura y tus objetivos para definir qué conservar y qué mejorar.'],
          ['¿Qué tipo de proyectos construyen?', 'Tiendas Shopify, sitios web, experiencias interactivas, aplicaciones, portales y MVP de SaaS.'],
          ['¿Cuánto tarda un proyecto?', 'El plazo depende del alcance y las integraciones. Lo definimos antes de comenzar.'],
          ['¿Qué necesitan para empezar?', 'Una descripción del negocio, el problema a resolver y una idea del presupuesto y plazo.']
        ].map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </section>

      <!-- Contact Section -->
      <section id="contact">
        <span class="eyebrow">Contacto</span>
        <h2>Hagamos algo<br/>diferente.</h2>
        <p>Cuéntanos qué necesita tu negocio y qué quieres construir.</p>
        <a class="contact-button" href={resolvePath('/start/')}>Iniciar conversación ↗</a>
      </section>

      <!-- Footer -->
      <footer>
        <strong>diferio.</strong>
        <p>Design / Software / Commerce / Motion</p>
        <a href="#main">Volver arriba ↑</a>
        <small>© {new Date().getFullYear()} DIFERIO</small>
      </footer>
    </main>
  </div>
</body>
</html>
